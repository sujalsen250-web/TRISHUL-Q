# =====================================================================
# TRISHUL-Q — configuration (.env)
# Copy this file to `.env` and adjust. NEVER commit the real .env to Git.
# =====================================================================

# ------------------------------------------------ application mode ----
# development | production
# In PRODUCTION there is NO silent SQLite fallback: if PostgreSQL is
# unreachable, startup fails loudly.
APP_ENV=development

# local | lan | live
APP_MODE=lan

# TRISHUL_HOST=0.0.0.0
# TRISHUL_PORT=8000

# ---------------------------------------------------------- database ----
# PostgreSQL is the PRIMARY, official datastore. Create the database first:
#   docker compose up -d db        (see docker-compose.yml)
#   -- or -- createdb trishulq
DATABASE_URL=postgresql+psycopg2://trishul:trishul@localhost:5432/trishulq

# Development-only SQLite fallback (ignored in production).
# TRISHUL_DB_FALLBACK=1

# Pooling (PostgreSQL only)
# TRISHUL_DB_POOL_SIZE=10
# TRISHUL_DB_MAX_OVERFLOW=20

# ---------------------------------------------------- accounts / seed ---
# The Super Admin is seeded ONCE (hashed) and never regenerated on restart.
# CHANGE THIS PASSWORD after first login.
TRISHUL_SUPERADMIN_USERNAME=superadmin
TRISHUL_SUPERADMIN_PASSWORD=TrishulQ@2026

# The Super Admin's own email — welcome credentials are emailed here for
# review / forwarding to the new Admin.
SUPER_ADMIN_EMAIL=

# Optionally seed one default online admin (normally admins are created
# through the Super Admin panel or an approved registration request).
TRISHUL_SEED_DEFAULT_ADMIN=0
# TRISHUL_DEFAULT_ADMIN_PASSWORD=TrishulAdmin@2026

# ------------------------------------------------------- secrets --------
# Used for auxiliary signing material. If unset, a random one is generated.
SECRET_KEY=
SESSION_SECRET=

# ------------------------------------------------------ public URL ------
# Used in emails (login links, reset links) and QR codes. Set this to your
# ngrok / public URL when exposing the app publicly.
PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------------------- Google login ---
# Google Cloud Console -> OAuth 2.0 Client ID (Web application).
# Add BOTH redirect URIs (localhost and your public/ngrok URL):
#   http://localhost:8000/api/auth/google/callback
#   https://your-domain.ngrok-free.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override; leave blank to derive from the request.
GOOGLE_REDIRECT_URI=

# ----------------------------------------------------------- SMTP mail ---
# All application email (admin welcome, password reset, password changed)
# goes through this. Leave blank to keep mail disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TRISHUL-Q
SMTP_USE_TLS=1
# SMTP_USE_SSL=0

# -------------------------------------------------------- password ------
# TRISHUL_PASSWORD_MIN_LENGTH=8
# TRISHUL_RESET_TTL_SECONDS=3600

# ------------------------------------------------------ rate limits -----
# TRISHUL_LOGIN_MAX_ATTEMPTS=6
# TRISHUL_LOGIN_WINDOW_SECONDS=300
# TRISHUL_RESET_MAX_REQUESTS=4
# TRISHUL_RESET_WINDOW_SECONDS=900

# --------------------------------------------------------- data paths ---
# TRISHUL_DATA_DIR=./data
# TRISHUL_UPLOAD_DIR=./uploads
# TRISHUL_MAX_FILE_SIZE=26214400
